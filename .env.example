# ---------- Database ----------
DATABASE_URL=postgres://nidhi:nidhi@localhost:5433/nidhi
PGSSLMODE=disable

# ---------- Cache ----------
REDIS_URL=redis://localhost:6380

# ---------- Object store (raw artifacts, immutable + content hashed) ----------
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=nidhi-raw
S3_ACCESS_KEY=nidhiminio
S3_SECRET_KEY=nidhiminio123
S3_FORCE_PATH_STYLE=true

# ---------- Data mode ----------
# live  = only data ingested by pipelines from cited public sources
# demo  = additionally loads the clearly labelled illustrative dataset, and the
#         UI renders a persistent "illustrative data" banner on every page.
DATA_MODE=demo

# ---------- Scraping posture (docs/08) ----------
# Honest User-Agent with a contact address is mandatory. Never remove.
# Sent as the From header (RFC 9110): a human who can ask us to stop.
# It must NOT go in the User-Agent, which some government portals reject
# outright when it contains an email address or a URL.
SCRAPER_CONTACT=contact@example.org
SCRAPER_USER_AGENT=NidhiDrishti/1.0 (public budget transparency project)
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_RESPECT_ROBOTS=true

# ---------- Source API keys ----------
# Free key from https://data.gov.in (OGD platform)
OGD_API_KEY=

# ---------- Agents ----------
# Provider for every agent model call: `ollama` (default) runs a local Llama
# model with no API key and no data leaving the machine; `anthropic` uses the
# hosted API. Model defaults follow the provider, so switching provider alone is
# enough. An explicit AGENT_MODEL_* below always wins.
AGENT_PROVIDER=ollama

# --- ollama provider (local, the default) ---
# Requires a running Ollama server (`ollama serve`) with the model pulled
# (`ollama pull llama3.1:8b`). One tag covers all three tiers out of the box;
# point the narrative tier at a larger tag (e.g. llama3.1:70b) if you have the
# VRAM. Set a smaller tag (e.g. llama3.2:3b) on the fast tier to speed A2/A3.
AGENT_OLLAMA_BASE_URL=http://localhost:11434
# Context window the local model is given. Raise it for long budget documents.
AGENT_OLLAMA_NUM_CTX=8192

# --- anthropic provider (hosted) ---
# Only read when AGENT_PROVIDER=anthropic. The live verification web search
# (below) has no local equivalent and needs this provider.
ANTHROPIC_API_KEY=

# Model tiers. Leave blank to take the provider's defaults (llama3.1:8b for
# ollama; the claude tiers below for anthropic).
AGENT_MODEL_FAST=
AGENT_MODEL_STANDARD=
AGENT_MODEL_NARRATIVE=

AGENT_ENABLE_WEB_SEARCH=false
# Comma separated. Only consulted when web search is on (anthropic provider only;
# the ollama provider has no server-side web search and rejects the tool).
# Defaults to the list in agents/lib/config.py: government primary sources plus
# established business press.
AGENT_WEB_SEARCH_ALLOWLIST=
AGENT_MAX_OUTPUT_TOKENS=8000
# Where the drift sentinel records sources whose canonical writes are paused.
AGENT_STATE_DIR=.agent-state

# ---------- Alerting (drift sentinel, pipeline failures) ----------
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Telemetry ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Web ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_REVIEW_TOKEN=change-me-locally
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
