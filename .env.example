# ---------- Database ----------
DATABASE_URL=postgres://nidhi:nidhi@localhost:5433/nidhi
PGSSLMODE=disable

# ---------- Cache ----------
REDIS_URL=redis://localhost:6380

# ---------- Object store (raw artifacts, immutable + content hashed) ----------
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=nidhi-raw
S3_ACCESS_KEY=nidhiminio
S3_SECRET_KEY=nidhiminio123
S3_FORCE_PATH_STYLE=true

# ---------- Data mode ----------
# live  = only data ingested by pipelines from cited public sources
# demo  = additionally loads the clearly labelled illustrative dataset, and the
#         UI renders a persistent "illustrative data" banner on every page.
DATA_MODE=demo

# ---------- Scraping posture (docs/08) ----------
# Honest User-Agent with a contact address is mandatory. Never remove.
SCRAPER_USER_AGENT=NidhiDrishti/1.0 (public budget transparency project; contact@example.org)
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_RESPECT_ROBOTS=true

# ---------- Source API keys ----------
# Free key from https://data.gov.in (OGD platform)
OGD_API_KEY=

# ---------- Agents ----------
ANTHROPIC_API_KEY=
AGENT_MODEL_FAST=claude-haiku-4-5-20251001
AGENT_MODEL_STANDARD=claude-sonnet-5
AGENT_MODEL_NARRATIVE=claude-opus-4-8
AGENT_ENABLE_WEB_SEARCH=false

# ---------- Alerting (drift sentinel, pipeline failures) ----------
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Telemetry ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Web ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_REVIEW_TOKEN=change-me-locally
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
