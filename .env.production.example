# Production environment for the self-hosted stack.
#
#     cp .env.production.example .env.production
#     docker compose -f infra/docker-compose.prod.yml --env-file .env.production up -d
#
# Every value marked REQUIRED has no default and the stack refuses to start
# without it. That is deliberate: each one is a value that would be dangerous to
# guess on your behalf.
#
# This file is a template and belongs in the repository. The file you make from
# it does not: .env.production is gitignored, and it holds your database
# password.

# ---------- REQUIRED ----------

# The public origin, with scheme and no trailing slash. Compiled into the client
# bundle at build time, so changing it requires `docker compose build web`, not
# just a restart. It is also what the share cards, the RSS feeds and the
# canonical URLs are built from, so a wrong value here is visible on Twitter
# before it is visible to you.
NEXT_PUBLIC_SITE_URL=https://example.org

POSTGRES_USER=nidhi
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=nidhi

# MinIO's root credentials and the pipelines' S3 credentials are the same pair.
# Generate both: openssl rand -base64 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nidhi-raw

# Mandatory and enforced in code: the User-Agent must name the project and carry
# a real contact address, so an operator who wants us to stop can reach a human
# without filing an abuse report (docs/08 section 1). Put an address you read.
# Sent as the From header (RFC 9110): a human who can ask us to stop.
# It must NOT go in the User-Agent, which some government portals reject
# outright when it contains an email address or a URL.
SCRAPER_CONTACT=you@example.org
SCRAPER_USER_AGENT=NidhiDrishti/1.0 (public budget transparency project)

# ---------- Data mode ----------
# live = only figures ingested from cited public sources. Anything else on a
# public deployment publishes sample numbers to the world; `demo` exists for a
# local walkthrough and shows a permanent banner saying so.
DATA_MODE=live

# ---------- Optional ----------

WEB_PORT=3000

# Free key from https://data.gov.in: My Account -> Generate Your New API KEY.
# Preferred over scraping wherever a dataset mirrors a document.
OGD_API_KEY=

# Guards the anomaly review queue at /admin/review. Generate one:
# openssl rand -hex 32
ADMIN_REVIEW_TOKEN=

# Agent layer. `ollama` needs no key and keeps every document on your own
# machine; from a container it reaches the host's Ollama through
# host.docker.internal, which the compose file wires up. `anthropic` needs a key
# and is the only provider that can do the live verification web search.
AGENT_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
ANTHROPIC_API_KEY=

# Where a drifted source or a failed pipeline is announced. Without one, a
# source that quietly stops updating is only visible on /ops.
ALERT_WEBHOOK_URL=

# Telemetry. All optional; the app degrades to no analytics and no error
# reporting rather than failing (docs/09).
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
