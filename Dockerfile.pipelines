# Ingestion and agent layer, as a self-contained image.
#
# One image for both because they share a dependency set and a settings module,
# and splitting them would mean maintaining two lockfiles for the sake of a few
# megabytes. What differs is the command:
#
#     docker run --env-file .env nidhi-pipelines python -m pipelines list
#     docker run --env-file .env nidhi-pipelines python -m pipelines run cga_monthly
#     docker run --env-file .env nidhi-pipelines python -m agents run a3_anomaly
#
# Built from the repository root:
#
#     docker build -f Dockerfile.pipelines -t nidhi-pipelines .

FROM python:3.12-slim AS base

# uv, pinned by digest-bearing tag rather than curl | sh, so the build is
# reproducible and does not depend on an installer script staying put.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /repo

# Dependencies first, from the manifests alone, so editing a parser does not
# reinstall pdfplumber.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY pipelines ./pipelines
COPY agents ./agents
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Not root. A scraper is the part of this system that handles the least trusted
# input in the whole product.
RUN useradd --create-home --uid 1001 nidhi && chown -R nidhi:nidhi /repo /opt/venv
USER nidhi

# No default pipeline. A container that runs "some pipeline" when started with
# no arguments is how a scheduler ends up quietly ingesting the wrong source.
ENTRYPOINT ["python"]
CMD ["-m", "pipelines", "list"]
