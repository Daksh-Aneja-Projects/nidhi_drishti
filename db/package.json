{
  "name": "@nidhi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file=../.env src/cli/migrate.ts",
    "seed": "tsx --env-file=../.env src/cli/seed.ts",
    "seed:demo": "tsx --env-file=../.env src/cli/seed.ts --demo",
    "refresh": "tsx --env-file=../.env src/cli/refresh.ts",
    "check": "tsx --env-file=../.env src/cli/check.ts",
    "reset": "tsx --env-file=../.env src/cli/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nidhi/core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
